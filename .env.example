# Copy to .env. Never upload .env, credentials, or engine data to static hosting.
# Set distinct random secrets (at least 32 characters). No usable secrets ship.
SCENARIO_PROXY_SECRET=
SCENARIO_CSRF_SECRET=
SCENARIO_PUBLIC_ORIGIN=https://oncotics.com
ENABLE_LOCAL_ENGINE=true
ENABLE_CLOUD_ENGINE=false
SCENARIO_TIMEOUT_SECONDS=14400
LOCAL_LLM_MODEL=qwen2.5:14b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
NEO4J_PASSWORD=
LOCAL_ENGINE_SECRET=
CLOUD_ENGINE_SECRET=
# Cloud settings are only required when enabling the cloud Compose profile.
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=
ZEP_API_KEY=
