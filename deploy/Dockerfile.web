FROM nginx:1.28-alpine
COPY index.html 404.html favicon* apple-touch-icon.png site.webmanifest robots.txt sitemap.xml humans.txt llms*.txt /usr/share/nginx/html/
COPY assets/ /usr/share/nginx/html/assets/
COPY about/ /usr/share/nginx/html/about/
COPY contact/ /usr/share/nginx/html/contact/
COPY privacy/ /usr/share/nginx/html/privacy/
COPY imaging/ /usr/share/nginx/html/imaging/
COPY precision-oncology-workspace/ /usr/share/nginx/html/precision-oncology-workspace/
COPY scenario-lab/ /usr/share/nginx/html/scenario-lab/
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/scenario-api.conf.template /etc/nginx/scenario-api.conf.template
COPY deploy/25-oncotics-scenario-api.sh /docker-entrypoint.d/25-oncotics-scenario-api.sh
RUN chmod 755 /docker-entrypoint.d/25-oncotics-scenario-api.sh
