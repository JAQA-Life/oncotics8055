# Build each engine from its own preserved repository; no source-tree merge.
FROM python:3.12.10-slim
ARG ENGINE_DIR
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FLASK_DEBUG=false
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /engine
COPY ${ENGINE_DIR}/ ./
RUN pip install --no-cache-dir -r backend/requirements.txt gunicorn==23.0.0 && useradd -u 10001 -m oncotics && mkdir -p backend/uploads && chown -R oncotics /engine
COPY deploy/engine_wsgi.py /engine/backend/oncotics_wsgi.py
USER oncotics
WORKDIR /engine/backend
EXPOSE 5001
# Upstream task registries are in-memory, so more than one process is unsafe.
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "1", "--threads", "8", "--timeout", "660", "oncotics_wsgi:app"]
