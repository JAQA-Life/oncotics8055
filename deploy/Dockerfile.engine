# Build each engine from its own preserved repository; no source-tree merge.
# OASIS 0.2.5 declares Python >=3.10,<3.12; MiroFish requires >=3.11.
FROM python:3.11.14-slim-bookworm
ARG ENGINE_DIR
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FLASK_DEBUG=false
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libcairo2 libmagic1 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /engine
COPY ${ENGINE_DIR}/ ./
COPY deploy/engine-constraints.txt /engine/oncotics-engine-constraints.txt
RUN pip install --no-cache-dir -c oncotics-engine-constraints.txt -r backend/requirements.txt gunicorn==23.0.0 && useradd -u 10001 -m oncotics && mkdir -p backend/uploads && chown -R oncotics /engine
COPY deploy/engine_wsgi.py /engine/backend/oncotics_wsgi.py
USER oncotics
WORKDIR /engine/backend
EXPOSE 5001
# Upstream task registries are in-memory, so more than one process is unsafe.
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "1", "--threads", "8", "--timeout", "660", "oncotics_wsgi:app"]
