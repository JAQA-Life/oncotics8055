limit_req_zone $binary_remote_addr zone=scenario_api:10m rate=5r/s;
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 64k;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Cross-Origin-Opener-Policy same-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  location = /api/scenarios { include /etc/nginx/scenario-api.conf; }
  location /api/scenarios/ { include /etc/nginx/scenario-api.conf; }
  location = /scenario-lab { return 308 /scenario-lab/; }
  location = /scenario-lab/source-code.zip { try_files $uri =404; }
  location /scenario-lab/ {
    auth_basic "Oncotics Research Scenario Lab";
    auth_basic_user_file /etc/nginx/auth/htpasswd;
    try_files $uri $uri/ =404;
  }
  location /assets/ohif/ {
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy credentialless always;
    add_header X-Content-Type-Options nosniff always;
    try_files $uri $uri/ /assets/ohif/index.html;
  }
  location /imaging/ {
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy credentialless always;
    add_header X-Content-Type-Options nosniff always;
    try_files $uri $uri/ =404;
  }
  location = /workspace { return 308 /precision-oncology-workspace/; }
  location = /workspace/ { return 308 /precision-oncology-workspace/; }
  location = /precision-oncology-workspace.html { return 308 /precision-oncology-workspace/; }
  location = /ohif { return 308 /imaging/; }
  location = /ohif/ { return 308 /imaging/; }
  location = /imaging-workbench { return 308 /imaging/; }
  location = /imaging-workbench/ { return 308 /imaging/; }
  location ~ /\. { deny all; }
  location / { try_files $uri $uri/ =404; }
}
