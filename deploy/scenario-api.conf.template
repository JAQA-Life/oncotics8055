auth_basic "Oncotics Research Scenario Lab";
auth_basic_user_file /etc/nginx/auth/htpasswd;
limit_req zone=scenario_api burst=20 nodelay;
limit_req_status 429;
proxy_pass http://scenario-api:8080;
proxy_set_header X-Oncotics-User $remote_user;
proxy_set_header X-Oncotics-Proxy ${SCENARIO_PROXY_SECRET};
proxy_set_header Host $host;
proxy_set_header Authorization "";
proxy_read_timeout 240s;
proxy_buffering off;
access_log off;
